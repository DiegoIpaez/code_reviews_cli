{
  "name": "code-reviews-cli",
  "version": "1.0.1",
  "description": "CLI tool for automating code review workflows",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "code-reviews": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "biome check .",
    "format": "biome format . --write"
  },
  "keywords": [
    "cli",
    "code-review",
    "automation",
    "github"
  ],
  "author": "DiegoIpaez",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4"
  }
}
